{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "math-analysis-v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "math-analysis-v1"
    },
    "verification_status": {
      "const": "unverified"
    },
    "understanding": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "error_location": {
      "type": "string",
      "minLength": 0,
      "maxLength": 1000
    },
    "answer_candidate": {
      "type": "string",
      "minLength": 0,
      "maxLength": 1500
    },
    "conditions": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      }
    },
    "solution_steps": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 800
      }
    },
    "knowledge_points": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      }
    },
    "review_items": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      }
    },
    "root_causes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "evidence",
          "confidence"
        ],
        "properties": {
          "category": {
            "enum": [
              "concept",
              "formula",
              "calculation",
              "reading",
              "missing_step",
              "diagram",
              "transfer",
              "unknown"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "hints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "text"
        ],
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "verification_status",
    "understanding",
    "error_location",
    "answer_candidate",
    "conditions",
    "solution_steps",
    "knowledge_points",
    "uncertainties",
    "review_items",
    "root_causes",
    "hints"
  ]
}
