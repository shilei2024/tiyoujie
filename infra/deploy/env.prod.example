# Copy to .env.prod on the deployment host; never commit real values.
# Generate with: openssl rand -base64 48
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com
DB_NAME=tiyoujie
DB_USER=tiyoujie
DB_PASSWORD=
REDIS_PASSWORD=
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379/0
# 应用只绑定回环端口，公网流量必须经主机 Caddy（见 apply-caddy.sh）。
API_HOST_PORT=18010
API_IMAGE=tiyoujie-api@sha256:REPLACE_WITH_REVIEWED_DIGEST
CREDENTIAL_KEYS_JSON=
CREDENTIAL_ACTIVE_KEY_VERSION=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
OCR_OUTBOUND_ENABLED=0
AI_ANALYSIS_ENABLED=0
PLATFORM_AI_ENABLED=0
PLATFORM_OCR_CONFIGURED_PROVIDERS=
PLATFORM_OCR_KEY_DEEPSEEK=
PLATFORM_OCR_KEY_KIMI=

# 基础编排（compose.yaml）的 dev 锚点会读取该变量，生产请与 DB_PASSWORD 填相同值；
# 生产数据库口令始终以 DB_PASSWORD 为准，该值不会被生产服务直接使用。
POSTGRES_PASSWORD=
