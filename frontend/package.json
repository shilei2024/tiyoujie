{
  "name": "tiyoujie-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev:h5": "uni --host 127.0.0.1 --port 15173",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "type-check": "vue-tsc --noEmit",
    "format:check": "prettier --check src vite.config.ts index.html *.json",
    "format": "prettier --write src vite.config.ts index.html *.json"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020620260917001",
    "@dcloudio/uni-components": "3.0.0-5020620260917001",
    "@dcloudio/uni-h5": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020620260917001",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-5020620260917001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "@types/node": "22.19.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "@dcloudio/vite-plugin-uni": {
      "vite": "$vite"
    },
    "express": "4.22.3",
    "esbuild": "0.25.12",
    "vite": "$vite",
    "vue": "$vue",
    "@babel/core": "7.29.7",
    "@intlify/core-base": "9.14.5",
    "@intlify/shared": "9.14.5",
    "@intlify/vue-devtools": "9.14.1",
    "@intlify/message-resolver": "9.1.11",
    "adm-zip": "0.6.1",
    "jpeg-js": "0.4.4",
    "phin": "3.7.1",
    "postcss": "8.5.31",
    "postcss-selector-parser": "7.1.6",
    "source-map-js": "1.2.2",
    "ws": "8.22.0",
    "@vue/compiler-core": "3.4.21",
    "@vue/compiler-dom": "3.4.21",
    "@vue/compiler-sfc": "3.4.21",
    "@vue/compiler-ssr": "3.4.21",
    "@vue/server-renderer": "3.5.44",
    "@vue/shared": "3.4.21",
    "@vue/reactivity": "3.4.21",
    "@vue/runtime-core": "3.4.21",
    "@vue/runtime-dom": "3.4.21"
  }
}
